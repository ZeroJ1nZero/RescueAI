<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <ImageButton
                android:id="@+id/btn_settings_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="뒤로가기"
                android:src="@android:drawable/ic_menu_revert" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="설정"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="지도 표시 설정"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_rescue_target"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="구조 대상"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_high_temp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="고온 구역"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_obstacle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="장애물 · 경고"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_safe_route"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="안전 경로"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_camera_pos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="카메라 · 현재 위치"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_door_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="문 · 출입구"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="표시 옵션"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_surface"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_object_id"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="물체 ID 표시"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_distance"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="거리 표시"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_movement_route"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="이동 경로 표시"
                android:textColor="@color/text_primary" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_observed_time"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="false"
                android:text="관측 시각 표시"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_show_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/accent_blue_bg"
                android:text="전체 표시"
                android:textColor="@color/accent_blue" />

            <Button
                android:id="@+id/btn_reset_default"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/bg_surface_elevated"
                android:text="기본값 복원"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>