# MariaDB Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=rescue_ai

# Security & JWT Configuration
SECRET_KEY=change-this-to-a-super-secret-key-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=INFO


# Gemma 3 4B (Ollama) - 임베디드 세션 프레임 분석용
GEMMA_API_URL=http://127.0.0.1:11434/api/generate
GEMMA_MODEL_NAME=gemma3:4b
